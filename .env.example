# Copy this file to .env and edit it. Docker Compose and the dev server both read .env.
# Every value is optional: the defaults below are what you get without a .env file.

# A sale is created once per SALE_ID, the first time the API starts with it. After that its
# window and stock are fixed, so to change them, use a new SALE_ID or wipe the data
# (`docker compose down -v`).
SALE_ID=launch

# When the sale opens: a delay after it's first created (30s, 5m, 1h),
# or an exact ISO-8601 time (2026-11-11T00:00:00Z).
SALE_START=15s

# When it closes: a duration after the start (30m, 2h), or an exact ISO-8601 time.
SALE_END=30m

# Units for sale.
STOCK=100
